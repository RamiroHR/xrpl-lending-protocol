# XRPL public Devnet — account seeds + classic addresses
# Fund accounts at: https://faucet.devnet.rippletest.net/accounts
# Copy this file to .env and fill in real seeds — never commit .env
# Addresses are derived from seeds (public); scripts/01_setup_accounts.ts writes both.

INVESTOR_A_SEED=
INVESTOR_A_ADDRESS=
INVESTOR_B_SEED=
INVESTOR_B_ADDRESS=
BORROWER_SEED=
BORROWER_ADDRESS=
BROKER_SEED=
BROKER_ADDRESS=
UNCREDENTIALED_SEED=
UNCREDENTIALED_ADDRESS=

# Network
XRPL_WSS=wss://s.devnet.rippletest.net:51233/
XRPL_RPC=https://s.devnet.rippletest.net:51234/

# Phase A smoke-test IDs (written by smoke_a2_vault_create.ts)
SMOKE_VAULT_ID=

# Phase B production vault + loan (auto-written by 02_create_vault.ts and 05_investment.ts)
VAULT_ID=
VAULT_SUB_DATE=
VAULT_REDEMPTION_DATE=
LOAN_ID=
LOAN_NEXT_PAYMENT_DUE=
LOAN_PERIODIC_PAYMENT=
